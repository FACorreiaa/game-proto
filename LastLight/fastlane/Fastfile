# The Last Light iOS lanes, adapted from ScanIt's (maat/scanit/fastlane/Fastfile).
#
#   test          the simulation's unit tests (swift test in ../LastLightCore)
#   beta          Release build -> TestFlight, internal testers only
#   seed_signing  one-time: register the App ID if missing and add its App Store profile to the
#                 shared match repo
#
# There is one app and one bundle id for now; a separate production app comes with the first release.
#
# Env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (base64 .p8), MATCH_PASSWORD, MATCH_GIT_BASIC_AUTHORIZATION.

default_platform(:ios)

PROJECT = "LastLight.xcodeproj"
SCHEME = "LastLight"
TARGET = "LastLight"
BUNDLE_ID = "com.fernandocorreia.lastlight"
APP_NAME = "The Last Light"
TEAM_ID = "84X9WYBF36"

platform :ios do
  desc "Run the simulation's unit tests"
  lane :test do
    sh("cd ../../LastLightCore && swift test")
  end

  desc "Build the Release configuration and upload it to TestFlight (internal)"
  lane :beta do
    api_key = asc_api_key
    setup_ci if is_ci
    match(type: "appstore", readonly: true, api_key: api_key)
    prepare_signing
    bump_build_number(api_key: api_key)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "One-time (re-runnable): register the App ID and create its App Store profile in the match repo"
  desc "Reuses the team's existing Apple Distribution certificate; needs write access to the repo."
  lane :seed_signing do
    api_key = asc_api_key
    setup_ci if is_ci
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    unless Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
      Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, platform: "IOS", identifier: BUNDLE_ID)
      UI.success("Registered App ID #{BUNDLE_ID}")
    end
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  # ---- helpers ----

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true
    )
  end

  # The project uses Xcode-managed signing for local development; the lane pins the match profile.
  private_lane :prepare_signing do
    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{BUNDLE_ID}",
      targets: [TARGET],
      build_configurations: ["Release"]
    )
  end

  # CFBundleVersion must exceed every earlier upload of this app, so read them all from App Store
  # Connect instead of trusting the project file.
  private_lane :bump_build_number do |options|
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: options[:api_key])
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("Create #{BUNDLE_ID} in App Store Connect first (docs/release.md)") unless app

    build_numbers = app.get_builds.map { |build| Integer(build.version, exception: false) }.compact
    increment_build_number(build_number: (build_numbers.max || 0) + 1, xcodeproj: PROJECT)
  end
end
