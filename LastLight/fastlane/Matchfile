# Signing reuses Khepri's match storage: NorthAIProject/north-ios-certificates, as ScanIt and Aaru do.
#
# The team (84X9WYBF36) is at Apple's limit of three distribution certificates, so The Last Light
# does not mint one. That repo holds the existing certificate BC73LRR48W; this app only adds its
# own App Store profile next to the others.
#
#   - MATCH_PASSWORD is Khepri's match password.
#   - MATCH_GIT_BASIC_AUTHORIZATION = base64 "x-access-token:<PAT>", PAT able to read
#     NorthAIProject/north-ios-certificates (read and write for `seed_signing`).
#   - BC73LRR48W expires 2027-09-23; when Khepri renews it, re-run `seed_signing`.
git_url("https://github.com/NorthAIProject/north-ios-certificates.git")
git_branch("main")
storage_mode("git")
type("appstore")
app_identifier(["com.fernandocorreia.lastlight"])
team_id("84X9WYBF36")
